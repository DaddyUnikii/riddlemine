// Read-only API regressions: compiling this declaration does not add the
// selector to Riddle; a missing currentTaxBps() must fail at runtime.
use ingot::{Riddle, Erc20, pool_address}

pub msg TaxQuoteRegression {
    #[selector = sol("currentTaxBps()")]
    CurrentTaxBps -> u256,
    #[selector = sol("pool()")]
    Pool -> Address,
    #[selector = sol("positionManager()")]
    PositionManager -> Address,
    #[selector = sol("distributor()")]
    Distributor -> Address,
}

#[test]
fn unstarted_tax_quote_returns_first_trade_rate() uses (evm: mut Evm) {
    let token = evm
        .create<Riddle>(
            value: Wei::zero(),
            args: (
                evm.address(),
                Address::new(0x313),
                Address::new(0xd15),
                Address::new(0xb0b),
                Address::new(0x9a1),
            ),
        )
    let rate: u256 = evm
        .call(
            addr: token,
            gas: 100000,
            value: Wei::zero(),
            message: TaxQuoteRegression::CurrentTaxBps {},
        )
    assert!(rate == 500, "quote must match first positive trade")
}
